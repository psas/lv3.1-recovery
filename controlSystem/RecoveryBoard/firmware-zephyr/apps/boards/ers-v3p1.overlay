/**
 * PSAS ERS board firmware
 */

&gpioa {
        status = "okay";
};

&gpiob {
        status = "okay";
};

/ {
        zephyr,user {
                /* adjust channel number according to pinmux in board.dts */
                io-channels = <&adc1 0>, <&adc1 1>, <&adc1 8>, <&adc1 9>; 
        };
};

&adc1 {
        #address-cells = <1>;
        #size-cells = <0>;

        channel@0 {
                reg = <0>;
                zephyr,gain = "ADC_GAIN_1";
                zephyr,reference = "ADC_REF_INTERNAL";
                zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
                zephyr,resolution = <12>;
        };

        channel@1 {
                reg = <1>;
                zephyr,gain = "ADC_GAIN_1";
                zephyr,reference = "ADC_REF_INTERNAL";
                zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
                zephyr,resolution = <12>;
        };

        channel@8 {
                reg = <8>;
                zephyr,gain = "ADC_GAIN_1";
                zephyr,reference = "ADC_REF_INTERNAL";
                zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
                zephyr,resolution = <12>;
        };

        channel@9 {
                reg = <9>;
                zephyr,gain = "ADC_GAIN_1";
                zephyr,reference = "ADC_REF_INTERNAL";
                zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
                zephyr,resolution = <12>;
        };
};

// CAN transceiver related

&can1 {
        status = "okay";
};

// digital-to-analog conversion (DAC) related

/ {
        zephyr,user {
                dac = <&dac1>;
                dac-channel-id = <1>;
                dac-resolution = <12>;
        };
};

&pwmleds {
        status = "okay";
};

&pwm2 {
        status = "okay";
};

&pwm1 {
        status = "okay";
};

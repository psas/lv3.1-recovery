/dts-v1/;
#include <st/f0/stm32f091Xc.dtsi>
#include <st/f0/stm32f091r(b-c)tx-pinctrl.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>

// TODO [ ] determine whether needed and how used:

/ {
        model = "ERS V3.1 board";
        compatible = "st,stm32f091rc-nucleo";

        chosen {
                zephyr,console = &usart2;
                zephyr,shell-uart = &usart2;
                zephyr,sram = &sram0;
                zephyr,flash = &flash0;
                zephyr,canbus = &can1;
                zephyr,dac = &dac1;
	};

	ers-gpios {
		compatible = "psas,ers-gpios", "gpio-keys";

		rocket_ready: rocket_ready {
			gpios = <&gpioa 7 0>;
		};

		not_umb_on: not_umb_on {
			gpios = <&gpioa 8 0>;
		};

		can_silent: can_silent {
			gpios = <&gpioa 9 0>;
		};

		can_shdn: can_shdn {
			gpios = <&gpioa 10 0>;
		};

		batt_read: batt_read {
			gpios = <&gpiob 0 0>;
		};

		not_motor_faila: not_motor_faila {
			gpios = <&gpiob 7 0>;
		};
	};

	leds {
		compatible = "gpio-leds";
		led_orange: led_orange {
			gpios = <&gpiob 14 GPIO_ACTIVE_LOW>;
		};

		deploy1: deploy1 {
			gpios = <&gpiob 4 0>;
		};

		deploy2: deploy2 {
			gpios = <&gpiob 5 0>;
		};

		not_motor_ps: not_motor_ps {
			gpios = <&gpiob 6 GPIO_ACTIVE_LOW>;
		};

	};

	gpio_keys {
		compatible = "gpio-keys";
		iso_drogue: iso_drogue {
			label = "isolated_drogue_chute";
			gpios = <&gpioa 5 GPIO_ACTIVE_HIGH>;
			zephyr,code = <INPUT_KEY_0>;
		};

		iso_main: iso_main {
			label = "isolated_main_chute";
			gpios = <&gpioa 6 0>;
			zephyr,code = <INPUT_KEY_1>;
		};
	};
};

&timers15 {
        st,prescaler = <10000>;
        status = "okay";

        pwm1: pwm {
                pinctrl-0 = <&tim15_ch1_pb14>;
                pinctrl-names = "default";
        };

        pwm2: pwm {
                /* NOTE: disabled by default, PWM2 conflicts with SPI1 */
                pinctrl-0 = <&tim15_ch2_pb15>;
                pinctrl-names = "default";
        };
};

/ {
        pwmleds: pwmleds {
                compatible = "pwm-leds";
                status = "disabled";

/// Note with this arrangement buzzer works but orange LED does not show PWM signal:
                pwm_led_orange: pwm_led_orange {
			pwms = <&pwm1 2 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
		};

                pwm_buzzer: pwm_buzzer {
                        pwms = <&pwm2 2 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
                };
        };

	aliases {
        	led0 = &led_orange;
		buzzer = &pwm_buzzer;
		sw0 = &iso_drogue;
		sw1 = &iso_main;
		sw2 = &not_umb_on;
		sw3 = &not_motor_faila;
		dout1 = &deploy1;
		dout2 = &deploy2;
		dout3 = &not_motor_ps;
	};
};

&clk_hse {
        /delete-property/ hse-bypass;
        clock-frequency = <DT_FREQ_M(16)>; // ERS board 16MHz crystal
        status = "okay";
};

&clk_lsi {
        status = "okay";
};

&pll {
        prediv = <1>;
        mul = <3>;
        clocks = <&clk_hse>;
        status = "okay";
};

&rcc {
        clocks = <&pll>;
        clock-frequency = <DT_FREQ_M(48)>;
        ahb-prescaler = <1>;
        apb1-prescaler = <1>;
        status = "okay";
};

&usart2 {
        pinctrl-0 = <&usart2_tx_pa2 &usart2_rx_pa3>;
        pinctrl-names = "default";
        current-speed = <115200>;
        status = "okay";
};

&iwdg {
        status = "okay";
};

&can1 {
        pinctrl-0 = <&can_rx_pa11 &can_tx_pa12>;
        pinctrl-names = "default";
        status = "okay";
};

&flash0 {
        partitions {
                compatible = "fixed-partitions";
                #address-cells = <1>;
                #size-cells = <1>;

                /* Set 6Kb of storage at the end of the 256Kb of flash */
                storage_partition: partition@3e800 {
                        label = "storage";
                        reg = <0x0003e800 DT_SIZE_K(6)>;
                };
        };
};

&adc1 {
        pinctrl-0 = <&adc_in0_pa0>;
        pinctrl-names = "default";
	// for Zephyr 3.7.0 the symbol SYNC requires arrow brackets:
        st,adc-clock-source = <SYNC>;
	// for Zephyr 4.3.0 the symbol SYNC requires double quotes:
        // st,adc-clock-source = "SYNC";
        st,adc-prescaler = <4>;
        status = "okay";
};

&dac1 {
        status = "okay";
        pinctrl-0 = <&dac_out1_pa4>;
        pinctrl-names = "default";
};
